{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                r.id,\n                r.title,\n                r.description,\n                r.status as \"status: ReportStatus\",\n                r.timeline,\n                r.impact,\n                r.created_at\n            FROM reports r\n            WHERE r.created_at >= CURRENT_DATE - $1::int\n              AND r.status IN ('draft', 'verified')\n              AND ($2::text IS NULL OR r.title ILIKE $2)\n            ORDER BY r.created_at DESC\n            OFFSET $3 LIMIT $4\n            ",
  "describe": {
    "columns": [
      {
        "ordinal": 0,
        "name": "id",
        "type_info": "Uuid"
      },
      {
        "ordinal": 1,
        "name": "title",
        "type_info": "Varchar"
      },
      {
        "ordinal": 2,
        "name": "description",
        "type_info": "Text"
      },
      {
        "ordinal": 3,
        "name": "status: ReportStatus",
        "type_info": {
          "Custom": {
            "name": "report_status",
            "kind": {
              "Enum": [
                "draft",
                "pending",
                "verified",
                "in_progress",
                "resolved",
                "rejected"
              ]
            }
          }
        }
      },
      {
        "ordinal": 4,
        "name": "timeline",
        "type_info": "Text"
      },
      {
        "ordinal": 5,
        "name": "impact",
        "type_info": "Text"
      },
      {
        "ordinal": 6,
